                "bin_exe",
                "bin_alias",
                "bin_entries",
                "notes"
            ],
            "refs": [
                "claude-desktop"
            ]
        },
        {
            "id": "portable-multifile",
            "label": "Portable · main archive plus sidecar files",
            "when": "One package needs several downloads: the main archive plus a helper script, an icon, or a hotfix archive. url and hash become arrays, and autoupdate tracks only the main download.",
            "builder": "portable_multifile",
            "defaults": {},
            "required": [
                "version",
                "desc",
                "homepage",
                "license",
                "url64",
                "hash64",
                "extra_urls",
                "extra_hashes"
            ],
            "optional": [
